# Frontend Environment Variables
# ==============================

# API Base URL for backend
VITE_API_BASE_URL=http://localhost:3001/api

# Stripe Publishable Key (public, safe to expose in client)
# Get your test key from: https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx


# Backend Environment Variables
# ==============================

# Server port
PORT=3001

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# JWT Secret for token signing (generate a secure random string)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Stripe Secret Key (private, never expose in client)
# Get your test key from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxx

# Stripe Webhook Secret
# Get this when creating a webhook endpoint in Stripe Dashboard
# For local development with Stripe CLI: stripe listen --forward-to localhost:3001/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Database URL (optional - for production with real database)
# DATABASE_URL=postgresql://user:password@localhost:5432/safar_giki
