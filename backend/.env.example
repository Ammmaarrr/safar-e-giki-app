# Backend Environment Variables
# ==============================

# Server port
PORT=3001

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# JWT Secret for token signing (generate a secure random string)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Supabase Configuration
# Get your keys from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Safepay Configuration
# Get your keys from: https://getsafepay.com/dashboard
SAFEPAY_API_KEY=sec_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SAFEPAY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SAFEPAY_WEBHOOK_SECRET=your-webhook-secret
SAFEPAY_SANDBOX=true

# Safepay Callback URLs
SAFEPAY_SUCCESS_URL=http://localhost:5173/payment/callback
SAFEPAY_CANCEL_URL=http://localhost:5173/payment/cancelled
